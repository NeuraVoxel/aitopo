{
  "name": "@neuravoxel/aitopo",
  "description": "Canvas topology engine for AI graphs (Document/Patch/Events + dirty-rect Network)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/types/**/*.js",
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "demo": "vite --config demo/vite.config.ts",
    "verify-notes": "ai-eng verify-notes .agents/notes",
    "bundle:iife": "node scripts/bundle-iife.mjs",
    "bundle:topo-diagram-skill": "node .agents/skills/topo-diagram/scripts/bundle-aitopo.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run verify-notes && pnpm test && pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^18.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.8",
    "ws": "^8.21.3"
  },
  "license": "MIT"
}
